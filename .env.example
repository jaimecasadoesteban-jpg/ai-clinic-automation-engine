# Copia este fichero a .env y rellena los valores.
# .env NO se versiona. Nunca pongas secretos reales aquí.

# Entorno: development | test | production
NODE_ENV=development

# Servidor HTTP del núcleo (solo lo consume n8n, no se expone a internet)
HOST=127.0.0.1
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Base de datos (Postgres / Supabase) --------------------------------------
# RUNTIME: pooler de transacciones (6543). Es el que usa el núcleo.
# Ojo con el usuario: debe ser `motor_app`, NO `postgres`. El rol `postgres` es
# propietario de las tablas y se salta RLS — el aislamiento entre clínicas se
# quedaría desactivado sin que ningún test lo notara.
DATABASE_URL=postgres://motor_app:CHANGE_ME@db.example.com:6543/postgres

# MIGRACIONES: conexión directa (5432). El pooler de transacciones no vale:
# drizzle-kit hace DDL y toma locks de sesión, que allí no sobreviven.
DIRECT_URL=postgres://postgres:CHANGE_ME@db.example.com:5432/postgres

# --- Base de datos de pruebas (Docker local, `npm run db:test:up`) ------------
# Sin contraseña porque el contenedor usa autenticación `trust`, está atado a
# localhost y sus datos mueren al pararlo. Los tests de aislamiento NO se saltan
# si faltan estas variables: fallan.
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5544/motor_test
TEST_APP_DATABASE_URL=postgres://motor_app@127.0.0.1:5544/motor_test

# --- Secretos ------------------------------------------------------------------
# Pimienta del HMAC de la lista de bajas. CRÍTICA Y NO ROTABLE: no guardamos los
# teléfonos originales, así que no se puede recalcular. Perderla es perder la
# capacidad de comprobar quién pidió no recibir más mensajes. Ver docs/DESIGN_RULES.md.
SUPPRESSION_PEPPER=pimienta-de-pruebas-larga

# Token compartido con n8n. TODOS los endpoints salvo /salud lo exigen, como
# cabecera `Authorization: Bearer <token>`. Que el núcleo no esté expuesto a
# internet es una propiedad del despliegue, no del código.
NUCLEO_API_TOKEN=genera-uno-largo-y-aleatorio-aqui

# Proveedor del LLM: única salida al exterior permitida desde el núcleo.
ANTHROPIC_API_KEY=

# Webhooks de n8n que exponen la agenda (sólo lectura). El núcleo pregunta aquí
# por disponibilidad y por si un hueco sigue libre; nunca escribe.
N8N_AGENDA_URL=http://127.0.0.1:5678/webhook/agenda/

# Avisos al operador (quien mantiene el sistema, no la clínica), por correo.
# Obligatorias: sin ellas el núcleo no arranca. Con Gmail, SMTP_PASS es una
# contraseña de aplicación (myaccount.google.com/apppasswords), nunca la de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
OPERADOR_CORREO=

# WhatsApp sin n8n. Las tres o ninguna: sin ellas, el webhook sigue en n8n.
# WHATSAPP_TOKEN: token de acceso de Meta (sin «Bearer»). WHATSAPP_APP_SECRET:
# Configuración → Básica de la app en developers.facebook.com. WHATSAPP_VERIFY_TOKEN:
# una frase larga que eliges tú y pones en Meta al configurar el webhook.
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# WhatsApp por Chatwoot (coexistencia). Las dos o ninguna: sin ellas, /chatwoot
# no se monta. CHATWOOT_API_TOKEN: Chatwoot → Perfil → Token de acceso.
# CHATWOOT_WEBHOOK_SECRET: el secreto que da Chatwoot al crear el webhook
# (Ajustes → Integraciones → Webhooks). La cuenta y el inbox de cada clínica van
# en su YAML (canal.chatwoot), no aquí.
# CHATWOOT_URL=https://app.chatwoot.com
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=

# Google Calendar sin n8n, con el mismo cliente OAuth de producción. Las tres o
# ninguna. Con ellas el núcleo lee la agenda y, en modo automatica, crea la
# cita; sin ellas lee por N8N_AGENDA_URL y ninguna clínica puede estar en
# automatica (no arranca). El refresh token sale una vez del OAuth Playground.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Panel del operador (/panel). Las tres o ninguna. PANEL_CLAVE_HASH es el hash,
# nunca la contraseña:
#   read -s CLAVE && echo "$CLAVE" | npx tsx src/panel-clave.ts; unset CLAVE
# PANEL_SECRETO firma las sesiones: 32 caracteres o más, al azar
# (openssl rand -base64 48). Cambiarlo cierra todas las sesiones.
PANEL_USUARIO=
PANEL_CLAVE_HASH=
PANEL_SECRETO=
